# probefleet coordinator — environment for docker-compose.yml.
# Copy to `.env` and edit. Only PROBEFLEET_PUBLIC_URL is required.

# --- compose ---------------------------------------------------------------
# Host interface/port the coordinator is published on (proxy upstream).
PROBEFLEET_BIND=127.0.0.1
PROBEFLEET_PORT=7000
# PROBEFLEET_IMAGE=probefleet:latest
# uid/gid the coordinator runs as. The container chowns /data to this on
# start; with a bind mount (e.g. ./data), set it to your host user (id -u / id -g).
# PUID=10001
# PGID=10001

# --- coordinator -----------------------------------------------------------
# The public HTTPS URL of the reverse proxy. Clients and nodes dial this,
# and OAuth callbacks are <PROBEFLEET_PUBLIC_URL>/auth/<name>/callback.
PROBEFLEET_PUBLIC_URL=https://fleet.example

# Log filter (tracing EnvFilter syntax).
RUST_LOG=info

# Optional knobs; unset means the coordinator default.
# PROBEFLEET_DEFAULT_ORG=default
# PROBEFLEET_ALLOW_ORG_CREATION=true
# PROBEFLEET_MAX_ORGS_PER_USER=10
# Keep the ping interval below your proxy's idle WebSocket timeout.
# PROBEFLEET_PING_INTERVAL_SECS=20
# PROBEFLEET_PONG_TIMEOUT_SECS=60
# PROBEFLEET_SESSION_TTL_SECS=43200

# --- login provider (optional) --------------------------------------------
# github | codeberg | gitlab | oidc. Leave unset for no login provider
# (bootstrap with `coordinator user-token` instead).
# PROBEFLEET_AUTH_KIND=github
# PROBEFLEET_AUTH_NAME=github
# PROBEFLEET_AUTH_CLIENT_ID=
# PROBEFLEET_AUTH_CLIENT_SECRET=
# Required for `oidc`; optional override for codeberg/gitlab/GHES.
# PROBEFLEET_AUTH_ISSUER=

# --- GitHub Actions workload identity (optional) ---------------------------
# Enables `probefleet ci login`. Set to PROBEFLEET_PUBLIC_URL.
# PROBEFLEET_GITHUB_ACTIONS_AUDIENCE=https://fleet.example

# --- anything else -----------------------------------------------------------
# Path (inside the container) of a TOML snippet appended verbatim to the
# generated config: [policy], additional [[auth.providers]], ... Mount it via
# the commented volume in docker-compose.yml.
# PROBEFLEET_EXTRA_CONFIG=/etc/probefleet/extra.toml
